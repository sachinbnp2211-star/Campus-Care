# -------------------------------------------------------------
# CampusCare Environment Configuration Template
# Copy this file to .env and configure the values for your environment.
# Never commit real passwords, secrets, or credentials to git.
# -------------------------------------------------------------

# Application Environment ('development', 'test', 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple, no trailing slashes)
# In production, set to your exact domain, e.g. https://campuscare.university.edu
CLIENT_URL=http://localhost:5173

# Frontend API URL for Vite build
VITE_API_URL=http://localhost:5000/api

# JSON Web Token Secret (Minimum 32 cryptographically random characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=campus_user
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=campus_complaint_db
DB_CONNECTION_LIMIT=10

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Reverse Proxy Setting (Set to 1 if behind Nginx/ALB/Cloudflare)
TRUST_PROXY=1

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=1000
